@startuml sequence-harvest-match-suggestion
!include elvira.iuml
' =============================================================================
' What: a harvested record that no identifier matched (or that is ambiguous
'       between entries sharing one) gets a suggested entry from the decider;
'       the record is held, never linked, until a librarian accepts (link) or
'       rejects (create as new). No decider, a dry run, `none` or an error:
'       the record goes on as before.
' Kind: UML sequence diagram. Scope: harvest run (non-sync sources), the
'       suggestions API of the conflicts inbox. Omitted: auth, advisory lock
'       details, field policy.
' Source: EvilFlowersCatalog issue 207 (2026-11-16); IP-034 "Matching".
' =============================================================================

title Harvest match suggestion: decider proposes, librarian decides (issue 207, 2026-11-16)

participant "harvest.run\nRun + Applier" as run
participant "MatchIndex\n(exact identifiers)" as index
participant "Suggester\napps.harvest.suggest" as suggester
database "postgresql18\nentries · harvest_records\n· harvest_match_suggestions" as db
participant "decider (Laya)\nPOST /v1/systemone/batch" as decider
actor "Librarian\nportal conflicts inbox" as librarian
participant "harvest API\n/api/v1/harvest/match-suggestions" as api

== harvest run ==
run -> index : match(record)
index --> run : unmatched · ambiguous(candidates)
alt EVILFLOWERS_DECIDER_URL set, not a dry run, no decided suggestion
  run -> db : pending suggestion of this record?
  alt pending
    run -> db : row status = suggested (not asked again)
  else none yet
    run -> suggester : suggest(record, candidates)
    suggester -> db : candidates: shared identifier, else\nsearch_vector @@ title words | surnames,\nyear ± 1 (or none); top EVILFLOWERS_DECIDER_MATCH_CANDIDATES
    suggester -> decider : choice {entry id → "title / authors / year / publisher", none}\nstate = record title, authors, year, publisher, language
    alt an entry
      decider --> suggester : choice, p, model
      suggester --> run : Suggestion
      run -> db : row status = suggested;\nMatchSuggestion(pending, entry, p, decider_model)
    else none · DeciderError (stops asking for the run)
      decider --> suggester : none / error
      run -> run : as today: create (create mode) · unmatched · ambiguous
    end
  end
else no decider · dry run · sync source · rejected before
  run -> run : as today
end
note right of run : an identifier match on a later run\nmarks the pending suggestion superseded

== librarian ==
librarian -> api : GET ?status=pending&source_id=
api --> librarian : record, suggested entry, p, candidates
alt accept
  librarian -> api : POST /{id}/accept
  api -> db : link (system_key) or enrich per mode;\nrow matched (matched_on = decider); suggestion accepted
else reject
  librarian -> api : POST /{id}/reject
  api -> db : create mode: new entry, row created;\nother modes: row unmatched; suggestion rejected
end
api -> api : evilflowers.decider.answers{task=harvest_match,\nanswer=suggested|none|accepted|rejected}
@enduml
