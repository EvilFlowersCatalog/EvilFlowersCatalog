  <link rel="stylesheet" href="elvira.css">
  <script>
    // Colour mode before paint, shared with the landing page and elvira.digital (Docusaurus `theme`).
    (function () {
      try {
        var mode = localStorage.getItem("redoc.colorMode") || localStorage.getItem("theme");
      } catch (_) {}
      // Always a class: Redoc's own `:root.dark` tokens and ours then agree.
      if (mode !== "light" && mode !== "dark") {
        mode = window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.classList.add(mode);
    })();
  </script>
  {{{redocHead}}}
  <style>
    /* Redoc 3 reads its design tokens from :root and :root.dark; `html:root` outranks both. */
    html:root {
      --navbar-height: var(--e-bar-height);
      --font-family-base: var(--e-font-text);
      --heading-font-family: var(--e-font-display);
      --heading-font-weight: 600;
      --font-family-monospaced: var(--e-font-mono);
      --code-font-family: var(--e-font-mono);
      --code-block-font-family: var(--e-font-mono);
      --http-tag-font-family: var(--e-font-mono);
      --border-radius: var(--e-radius);
      --border-radius-md: var(--e-radius);
      --border-radius-lg: var(--e-radius);

      --bg-color: var(--e-paper);
      --bg-color-raised: var(--e-paper);
      --text-color: var(--e-ink);
      --text-color-primary: var(--e-ink);
      --text-color-secondary: var(--e-muted);
      --text-color-description: var(--e-muted);
      --heading-text-color: var(--e-ink);
      --border-color-primary: var(--e-rule);
      --border-color-secondary: var(--e-rule-strong);

      --color-primary-base: var(--e-accent);
      --color-primary-hover: var(--e-accent-hover);
      --color-primary-active: var(--e-accent-hover);
      --color-primary-text: var(--e-accent);
      --color-primary-text-hover: var(--e-accent-hover);
      --color-primary-text-active: var(--e-accent-hover);
      --color-primary-bg: var(--e-accent-wash);
      --color-primary-bg-hover: var(--e-accent-wash);
      --color-primary-border: var(--e-accent);
      --color-primary-border-hover: var(--e-accent-hover);
      --link-color-primary: var(--e-accent);
      --link-color-primary-hover: var(--e-ink);
      --link-color-primary-pressed: var(--e-ink);
      --link-color-visited: var(--e-accent);

      --sidebar-bg-color: var(--e-wash);
      --sidebar-border-color: var(--e-rule);
      --sidebar-text-color: var(--e-ink);
      --sidebar-font-family: var(--e-font-text);
      --menu-item-text-color: var(--e-muted);
      --menu-item-color-hover: var(--e-ink);
      --menu-item-color-active: var(--e-accent);
      --menu-item-bg-color-hover: transparent;
      --menu-item-bg-color-active: var(--e-accent-wash);
      --menu-content-title-color: var(--e-ink);
    }
    html:root.dark {
      --bg-color: var(--e-paper);
      --bg-color-raised: var(--e-wash);
      --layer-color: var(--e-wash);
      --layer-color-raised: var(--e-wash);
      --code-panel-bg-color: var(--e-wash);
      --sidebar-bg-color: var(--e-wash);
    }
    body {
      margin: 0;
      padding: 0;
      background: var(--e-paper);
      color: var(--e-ink);
    }
  </style>
</head>
