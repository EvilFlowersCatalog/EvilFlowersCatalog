# General
INSTANCE_NAME=evilflowers.local

# HTTPS bullshit
SECURE_SSL_REDIRECT=1

# Database
PGHOST=localhost
PGPORT=5432
PGDATABASE=evil_flowers_catalog
PGUSER=postgres
PGPASSWORD=admin
# 1 when PGHOST/PGPORT is PgBouncer in transaction mode: turns off server-side cursors.
# PGBOUNCER_TRANSACTION_POOLING=0
# Connection pool per gunicorn worker (#133), gunicorn only (Celery and management commands connect per
# task/command). Client connections to PgBouncer: workers (4) x PGPOOL_MAX; in PgBouncer session mode
# each pins a server connection, so keep that under the database's max_db_connections.
# EVILFLOWERS_DB_POOL=0
# PGPOOL_MIN=2
# PGPOOL_MAX=10
# PGPOOL_TIMEOUT=5
# PGPOOL_MAX_IDLE=300
# PGPOOL_HEALTH_CHECKS=0

# Redis
REDIS_HOST=127.0.0.1
REDIS_DATABASE=1

SECRET_KEY=''

# Authentication
SECURED_VIEW_JWT_ALGORITHM=RS256
SECURED_VIEW_JWK=
SECURED_VIEW_JWT_ACCESS_TOKEN_EXPIRATION=5
SECURED_VIEW_JWT_REFRESH_TOKEN_EXPIRATION=1440

# EvilFlowers Specific
EVILFLOWERS_CONTACT_EMAIL=arthur.dent@example.com
EVILFLOWERS_USER_ACQUISITION_MODE=single
EVILFLOWERS_ENFORCE_USER_ACQUISITIONS=1
# Days a personal activity history row is kept after its last occurrence (IP-016)
EVILFLOWERS_ACTIVITY_RETENTION_DAYS=365
# Ratings and reviews (IP-023). 0 turns the endpoints off.
EVILFLOWERS_REVIEWS_ENABLED=1
EVILFLOWERS_REVIEWS_BODY_MAX_CHARS=5000

## Filesystem storage
EVILFLOWERS_STORAGE_DRIVER=apps.files.storage.filesystem.FileSystemStorage
EVILFLOWERS_STORAGE_FILESYSTEM_DATADIR=/mnt/data

## S3 Storage
EVILFLOWERS_STORAGE_S3_HOST=127.0.0.1:9000
EVILFLOWERS_STORAGE_S3_ACCESS_KEY=O8TgsPCaWvzvl6xR
EVILFLOWERS_STORAGE_S3_SECRET_KEY=fpVFOivTa1NlPcBcKbCp8EGHaJe5m2Oq
EVILFLOWERS_STORAGE_S3_SECURE=0
EVILFLOWERS_STORAGE_S3_BUCKET=evilflowers

## Backup
EVILFLOWERS_BACKUP_DESTINATION='s3://bucket/directory'
EVILFLOWERS_BACKUP_SCHEDULE='0 3 * * *'
EVILFLOWERS_BACKUP_S3_HOST=fra1.example.com
EVILFLOWERS_BACKUP_S3_ACCESS_KEY=
EVILFLOWERS_BACKUP_S3_SECRET_KEY=
EVILFLOWERS_BACKUP_S3_SECURE=1
# pg_dump straight to PostgreSQL, past PgBouncer. Unset = PGHOST/PGPORT.
# EVILFLOWERS_BACKUP_PGHOST=172.28.1.1
# EVILFLOWERS_BACKUP_PGPORT=5432

## Orphan cleanup: delete storage directories no catalog/entry owns. Unset schedule = off.
# EVILFLOWERS_ORPHAN_CLEANUP_SCHEDULE='30 4 * * 0'
EVILFLOWERS_ORPHAN_CLEANUP_MIN_AGE_HOURS=168

# Logging (IP-019): json = one object per line with `level` and `trace_id` (what
# Grafana Alloy parses); text = human-readable, for a terminal.
EVILFLOWERS_LOG_FORMAT=text
DJANGO_LOG_LEVEL=INFO

# OpenTelemetry (IP-019) — standard OTEL_* variables, see docs/observability.md.
# Telemetry is off unless an endpoint is set or discovered, or a console exporter is chosen.
#
# Collector endpoint (OTLP/HTTP). Leave unset in Docker: each process then probes
# <default gateway>:4318 once (the node's Alloy agent) and stays off if nothing answers.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://172.28.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# false = never probe for a collector.
OTEL_EXPORTER_OTLP_AUTODISCOVER=true
# Kubernetes: HOST_IP from the downward API (status.hostIP) is probed instead of the gateway.
# HOST_IP=
OTEL_SERVICE_NAME=evilflowers
# true = the reader's user id (`enduser.id`) on request spans; with the entry ids there it is a reading log (IP-029 Q1).
EVILFLOWERS_TRACE_ENDUSER=false
OTEL_RESOURCE_ATTRIBUTES=service.namespace=elvira,deployment.environment.name=development
# otlp (default) | console | none
# OTEL_TRACES_EXPORTER=console
# OTEL_METRICS_EXPORTER=console
# OTEL_SDK_DISABLED=true
# Defaults set by the app when unset:
# OTEL_SEMCONV_STABILITY_OPT_IN=http,database   # stable HTTP + DB attribute names (seconds, http.route, db.system.name)
# OTEL_PYTHON_DJANGO_EXCLUDED_URLS=api/v1/status # healthcheck is not traced
# OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=mcp-protocol-version,accept-language
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_PROPAGATORS=tracecontext,baggage

# Pyroscope SDK continuous profiling (#111), see docs/observability.md. Unset = off.
# PYROSCOPE_SERVER_ADDRESS=http://pyroscope.observability.svc.cluster.local:4040
# PYROSCOPE_APPLICATION_NAME=evilflowers                  # default: OTEL_SERVICE_NAME
# PYROSCOPE_TAGS=namespace=evilflowers-dev,cluster=k8s-stu # a role=<process> tag is added
# PYROSCOPE_SAMPLE_RATE=20                                 # Hz (#136)
# PYROSCOPE_GIL_ONLY=                                      # default: false for gunicorn, true elsewhere
# PYROSCOPE_ROLES=gunicorn,celery-worker                   # * = every role

# Readium
EVILFLOWERS_READIUM_LCPSV_URL='http://username:password@127.0.0.1:8989'
EVILFLOWERS_READIUM_LSDSV_URL='http://127.0.0.1:8990'
EVILFLOWERS_READIUM_DATADIR=/mnt/readium

# Minio
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=Admin123
MINIO_ACCESS_KEY=O8TgsPCaWvzvl6xR
MINIO_SECRET_KEY=fpVFOivTa1NlPcBcKbCp8EGHaJe5m2Oq

# Event broker
# EVILFLOWERS_EVENT_BROKER_EXECUTOR=apps.events.services.CeleryEventExecutionService
EVILFLOWERS_EVENT_BROKER_EXECUTOR=apps.events.services.KafkaEventExecutionService
EVILFLOWERS_EVENT_BROKER_TRANSFORMER=apps.events.transformers.DjangoDransformer

# Kafka
KAFKA_HOST=127.0.0.1
KAFKA_PORT=9092

# Model Context Protocol server (IP-014) — POST /mcp/v1
EVILFLOWERS_MCP_ENABLED=1
EVILFLOWERS_MCP_DEFAULT_LIMIT=10
EVILFLOWERS_MCP_MAX_LIMIT=50
EVILFLOWERS_MCP_SUMMARY_MAX_CHARS=600
EVILFLOWERS_MCP_CONTENT_MAX_CHARS=4000
# Records one bulk write may touch (classify_entries, create_categories, …).
EVILFLOWERS_MCP_MAX_BULK_ITEMS=100
EVILFLOWERS_MCP_MAX_REQUEST_BYTES=1048576
# Management tools (create/update/delete catalogs, feeds, categories; classify
# entries; curate feed membership). 0 unmounts them from tools/list entirely.
EVILFLOWERS_MCP_ALLOW_WRITE=1
# 1 refuses anonymous sessions outright (no public browsing without a credential).
EVILFLOWERS_MCP_REQUIRE_AUTHENTICATION=0
# Bearer = API key JWT (revocable, preferred). Basic = username/password, resolved
# through the configured AuthSource (database or LDAP). Basic is off by default:
# with LDAP users it puts the directory password in an agent's config. Opt in
# with EVILFLOWERS_MCP_AUTHENTICATION_SCHEMAS=Bearer,Basic
EVILFLOWERS_MCP_AUTHENTICATION_SCHEMAS=Bearer
# Browser origins allowed to reach /mcp/v1 (DNS-rebinding guard). Default: the
# origin of EVILFLOWERS_BASE_URL. Requests without Origin always pass; * = no check.
# EVILFLOWERS_MCP_ALLOWED_ORIGINS=https://elvira.stuba.sk

# CORS. Default: the origin of EVILFLOWERS_PORTAL_URL only. Comma-separated.
# CORS_ALLOWED_ORIGINS=https://portal.example.org
# 1 lets any website call the API from a browser (old default, explicit opt-in).
# CORS_ALLOW_ALL_ORIGINS=0

# Chat assistant (IP-015) — /assistant/v1/
# 0 unmounts the route entirely.
EVILFLOWERS_ASSISTANT_ENABLED=1
# Full chat URL, e.g. http://localhost:11434/api/chat or https://ollama.com/api/chat.
# Endpoint and model are both required; without them every message fails.
EVILFLOWERS_ASSISTANT_OLLAMA_ENDPOINT=http://localhost:11434/api/chat
# In the STU cluster: elvira-assistant (Qwen3.6-35B-A3B + Modelfile, knowledge roles/inference).
EVILFLOWERS_ASSISTANT_OLLAMA_MODEL=
# Bearer token for Ollama cloud; leave blank for a local instance.
EVILFLOWERS_ASSISTANT_OLLAMA_API_KEY=
# Host header, for reaching the cluster's Ollama through the internal Gateway from Compose
# (e.g. llm.elvira.internal). Blank sends none.
EVILFLOWERS_ASSISTANT_OLLAMA_HOST=
# Seconds per socket read. On CPU inference this must cover the prompt evaluation before
# the first token, which can take tens of seconds for a long first round.
EVILFLOWERS_ASSISTANT_OLLAMA_TIMEOUT=300
EVILFLOWERS_ASSISTANT_OLLAMA_CONNECT_TIMEOUT=10
# 0 = "think": false (no hidden reasoning tokens; the default), 1 = think, blank = not sent.
EVILFLOWERS_ASSISTANT_OLLAMA_THINK=0
# options.num_ctx; keep equal to the server's OLLAMA_CONTEXT_LENGTH. 0 = not sent.
EVILFLOWERS_ASSISTANT_OLLAMA_NUM_CTX=32768
# keep_alive per request (-1 = never unload). Blank = not sent.
EVILFLOWERS_ASSISTANT_OLLAMA_KEEP_ALIVE=-1
# Sampling temperature; blank = the model's default.
EVILFLOWERS_ASSISTANT_OLLAMA_TEMPERATURE=
# Distinct PDF pages one chat turn or explanation may read (tool calls are not limited).
EVILFLOWERS_ASSISTANT_MAX_PAGES_READ=20
# Daily per-user quota (overridable per user via AssistantUserPolicy).
EVILFLOWERS_ASSISTANT_DAILY_LIMIT_MESSAGES=100
# Tokens are counted per model round (a turn has several), so this is not "tokens of answers".
EVILFLOWERS_ASSISTANT_DAILY_LIMIT_TOKENS=200000
# Seconds a conversation stays "warm": full history is replayed unchanged until then,
# after which only the last TRIM_MESSAGES messages are replayed.
EVILFLOWERS_ASSISTANT_CACHE_TTL=3600
EVILFLOWERS_ASSISTANT_TRIM_MESSAGES=20

# Hybrid search (IP-021): the shared tei-embed (multilingual-e5-large-instruct). Empty URL = lexical
# search only. Key: 1Password ELVIRA/stu.inference.tei/api_key.
EVILFLOWERS_EMBEDDING_URL=
EVILFLOWERS_EMBEDDING_API_KEY=
# Compose on gateway: URL http://192.168.122.227:8081 + HOST embed.elvira.internal; empty in k8s.
EVILFLOWERS_EMBEDDING_HOST=
# Pin the model so /info is never on the request path.
EVILFLOWERS_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct@274baa43b0e13e37fafa6428dbc7938e62e5c439
# Seconds a catalog search waits for TEI to embed the query before it runs on the words only (#134).
EVILFLOWERS_EMBEDDING_QUERY_TIMEOUT=0.3
EVILFLOWERS_SEARCH_VECTOR_MIN_SCORE=0.8