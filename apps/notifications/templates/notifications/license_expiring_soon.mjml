{% extends "notifications/base.mjml" %}

{% block content %}
<mj-section background-color="#ffffff" padding="30px 20px">
  <mj-column>
    <mj-text font-size="20px" font-weight="bold" padding-bottom="10px">Loan expiring soon</mj-text>
    <mj-text>Hello {{ user_name }},</mj-text>
    <mj-text>
      Your loan for <strong>{{ entry_title }}</strong>{% if entry_author %} by {{ entry_author }}{% endif %}
      expires on {{ expires_at }}{% if days_left is not None %} (in {{ days_left }} day{{ days_left|pluralize }}){% endif %}.
    </mj-text>
    <mj-text>If you need more time, renew the loan from your library shelf.</mj-text>
  </mj-column>
</mj-section>
{% endblock %}
