{% extends "notifications/base.mjml" %}

{% block content %}
<mj-section background-color="#ffffff" padding="30px 20px">
  <mj-column>
    <mj-text font-size="20px" font-weight="bold" padding-bottom="10px">Reservation expired</mj-text>
    <mj-text>Hello {{ user_name }},</mj-text>
    <mj-text>
      Your reservation for <strong>{{ entry_title }}</strong>{% if entry_author %} by {{ entry_author }}{% endif %}
      was not claimed before the deadline and has been passed to the next user in line.
    </mj-text>
    <mj-text>You are welcome to place a new reservation at any time.</mj-text>
  </mj-column>
</mj-section>
{% endblock %}
