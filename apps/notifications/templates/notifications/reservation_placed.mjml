{% extends "notifications/base.mjml" %}

{% block content %}
<mj-section background-color="#ffffff" padding="30px 20px">
  <mj-column>
    <mj-text font-size="20px" font-weight="bold" padding-bottom="10px">Reservation placed</mj-text>
    <mj-text>Hello {{ user_name }},</mj-text>
    <mj-text>
      You have been added to the queue for <strong>{{ entry_title }}</strong>{% if entry_author %} by {{ entry_author }}{% endif %}.
    </mj-text>
    <mj-text>
      Your position in line: <strong>#{{ position }}</strong>.
    </mj-text>
    {% if estimated_available_from and estimated_available_until %}
    <mj-text>
      Expected available between <strong>{{ estimated_available_from }}</strong> and <strong>{{ estimated_available_until }}</strong>.
      These are estimates — actual availability depends on whether borrowers renew or return early.
    </mj-text>
    {% elif estimated_available_from %}
    <mj-text>
      Expected available after <strong>{{ estimated_available_from }}</strong>.
      This is an estimate — actual availability depends on whether borrowers renew or return early.
    </mj-text>
    {% endif %}
    <mj-text>
      We will email you again as soon as a slot opens up. You will have {{ claim_window_hours }} hours to claim it.
    </mj-text>
  </mj-column>
</mj-section>
{% endblock %}
