{% comment %}
IP-025: the look comes from `brand` (NotificationBranding tokens over settings
defaults, see apps/notifications/branding.py). Every token has a default here
too, so `compile_templates` can render this with an empty context. A deployment
that needs a different structure overrides this file on the volume
(EVILFLOWERS_NOTIFICATION_OVERRIDES_DIR/templates/notifications/base.mjml).
{% endcomment %}<mjml>
  <mj-head>
    <mj-title>{{ library_name }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.6" />
      <mj-button background-color="{{ brand.primary_color|default:'#4A90D9' }}" color="{{ brand.button_text_color|default:'#ffffff' }}" border-radius="4px" font-size="16px" />
    </mj-attributes>
    <mj-style>
      .footer-text { font-size: 12px; color: #999999; }
      .footer-text a, .brand-link a { color: {{ brand.primary_color|default:'#4A90D9' }}; }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{ brand.background_color|default:'#f4f4f4' }}">
    <mj-section background-color="{{ brand.header_background|default:'#4A90D9' }}" padding="20px 0">
      <mj-column>
        {% if brand.logo_url %}
        <mj-image src="{{ brand.logo_url }}" alt="{{ brand.logo_alt }}" width="{{ brand.logo_width|default:200 }}px" align="center" padding="0 25px"{% if brand.logo_link %} href="{{ brand.logo_link }}"{% endif %} />
        <mj-text align="center" color="{{ brand.header_text_color|default:'#ffffff' }}" font-size="15px" padding="10px 25px 0">
          {{ library_name }}
        </mj-text>
        {% else %}
        <mj-text align="center" color="{{ brand.header_text_color|default:'#ffffff' }}" font-size="24px" font-weight="bold">
          {{ library_name }}
        </mj-text>
        {% endif %}
      </mj-column>
    </mj-section>
    <mj-section background-color="{{ brand.primary_color|default:'#4A90D9' }}" padding="0">
      <mj-column>
        <mj-spacer height="4px" />
      </mj-column>
    </mj-section>

    {% block content %}{% endblock %}

    <mj-section padding="20px 0">
      <mj-column>
        <mj-divider border-color="#e0e0e0" />
        {% if brand.footer_text %}
        <mj-text align="center" css-class="footer-text">
          {{ brand.footer_text|linebreaksbr }}
        </mj-text>
        {% endif %}
        {% if brand.website_url %}
        <mj-text align="center" css-class="footer-text">
          <a href="{{ brand.website_url }}">{{ brand.website_url }}</a>
        </mj-text>
        {% endif %}
        <mj-text align="center" css-class="footer-text">
          This is an automated notification from {{ library_name }}. Please do not reply to this e-mail.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
