<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.6" />
      <mj-button background-color="#4A90D9" color="#ffffff" border-radius="4px" font-size="16px" />
    </mj-attributes>
    <mj-style>
      .footer-text { font-size: 12px; color: #999999; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#4A90D9" padding="20px 0">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="24px" font-weight="bold">
          {{ library_name }}
        </mj-text>
      </mj-column>
    </mj-section>

    {% block content %}{% endblock %}

    <mj-section padding="20px 0">
      <mj-column>
        <mj-divider border-color="#e0e0e0" />
        <mj-text align="center" css-class="footer-text">
          This is an automated notification from {{ library_name }}. Please do not reply to this e-mail.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
