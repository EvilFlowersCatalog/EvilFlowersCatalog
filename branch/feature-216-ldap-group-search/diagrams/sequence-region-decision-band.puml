@startuml sequence-region-decision-band
!include elvira.iuml
' =============================================================================
' What: the catalog side of the decision models (issue 189). Workers post a region
'       with an optional decision (band, p, score, decision, decider_model,
'       table signals); the catalog stores it, bands it from configured
'       thresholds only when the worker sent none, and every reader surface
'       skips band = hide. Nothing is deleted; re-banding works from stored p.
' Kind: UML sequence diagram. Scope: ingestion, reader filter, describe sweep,
'       search documents, re-band command. Omitted: auth, telemetry, attempts.
' Source: EvilFlowersCatalog issue 189; knowledge Proposals/Decision-Models.md
'         (2026-11-16); image-service issue 6, text-service issue 20.
' =============================================================================

title Region decision band: store, hide by default, re-band from stored p (issue 189, 2026-11-16)

participant "image-service\n/ text-tables" as worker
participant "RunRegions\nPOST /extraction/v1/runs/{id}/regions" as ingest
database "postgresql18\nextraction_region · extraction_run" as db
participant "Reader surfaces\nREST · MCP content · figure search\n· assistant · graph" as readers
participant "describe-figures sweep\n+ post-process index_run" as sweep
actor "Operator\nmanage.py reband_regions" as operator

== ingestion ==
worker -> ingest : regions[] + optional {band, p, score, decision,\ndecider_model, review_outcome, grounded_share, signals}
ingest -> ingest : RegionForm: missing = unknown (null);\nsignals folded into decision_signals
alt band missing, p or score present, thresholds configured\n(EVILFLOWERS_DECIDER_BANDS)
  ingest -> ingest : band = bands.band_for(kind, decision, p, score)
end
ingest -> db : lock run row; bulk_create regions;\nrun.provenance.decider_models[job] = decider_model
ingest --> worker : 201 {count}

== readers (hide by default) ==
readers -> db : run.regions.visible()\n(band IS NULL OR band <> 'hide')
db --> readers : keep · review · unknown
note right of readers : admin list\n/api/v1/entries/{id}/extraction/regions\nreturns every band, ?band= filters

== sweeps ==
sweep -> db : describe: band IS NULL OR band = 'keep'
sweep -> db : index_run: hide → embedding_text, vector = null

== threshold change ==
operator -> db : rows with p or score (decision != repeated)
operator -> operator : band_for(...) with new thresholds
operator -> db : bulk_update band; index_run(runs whose hide state flipped)
@enduml
